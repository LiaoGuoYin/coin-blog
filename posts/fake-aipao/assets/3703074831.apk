      (function() {
        // Tab switching: must run synchronously before paint to prevent flash
        var path = location.pathname.replace(/\/+$/, '');
        var wantMemos = path === '/memo' || location.hash.indexOf('#memos-') === 0;
        if (wantMemos) {
          var tp = document.getElementById('tab-posts');
          var tm = document.getElementById('tab-memos');
          if (tp) tp.classList.add('tab-hidden');
          if (tm) tm.classList.remove('tab-hidden');
        }

        // Restore saved view toggle (list/grid)
        var saved = localStorage.getItem('post-view');
        if (saved === 'grid') {
          var l = document.getElementById('post-list');
          if (l) { l.classList.replace('post-list--list', 'post-list--grid'); }
          var t = document.getElementById('view-toggle');
          if (t) {
            t.dataset.active = 'grid';
            var btns = t.querySelectorAll('.view-toggle-btn');
            btns[0].classList.remove('is-active');
            btns[1].classList.add('is-active');
          }
        }
      })();
    </script> <!-- Memos tab --> <section id="tab-memos" class="tab-hidden" data-api="https://memo.nas.hz.moyumomokan.cn" data-page-size="20"> <h2 class="text-base font-semibold mb-4" style="color: var(--bronze-12);"> Memos </h2> <!-- Loading skeleton --> <div id="memo-loading" class="timeline"> <div class="tl-item"> <span class="tl-dot"></span> <div class="tl-content"> <div class="skeleton skeleton-date"></div> <div class="skeleton skeleton-body"></div> </div> </div><div class="tl-item"> <span class="tl-dot"></span> <div class="tl-content"> <div class="skeleton skeleton-date"></div> <div class="skeleton skeleton-body"></div> </div> </div><div class="tl-item"> <span class="tl-dot"></span> <div class="tl-content"> <div class="skeleton skeleton-date"></div> <div class="skeleton skeleton-body"></div> </div> </div><div class="tl-item"> <span class="tl-dot"></span> <div class="tl-content"> <div class="skeleton skeleton-date"></div> <div class="skeleton skeleton-body"></div> </div> </div><div class="tl-item"> <span class="tl-dot"></span> <div class="tl-content"> <div class="skeleton skeleton-date"></div> <div class="skeleton skeleton-body"></div> </div> </div> </div> <!-- Error state --> <p id="memo-error" class="text-sm tab-hidden" style="color: var(--sand-11);"> No memos yet. </p> <!-- Memo list (populated by JS) --> <div id="memo-list" class="timeline tab-hidden"></div> <!-- Load more --> <div id="memo-load-more" class="tab-hidden" style="text-align: center; padding: 1rem 0;"> <button id="memo-load-more-btn" class="load-more-btn" data-load-more="查看更多" data-loading="加载中…" data-no-more="没有更多了"> 查看更多 </button> </div> </section> </div>  </div> </main> </div> <!-- Cloudflare Pages Analytics --><script defer src='https://static.cloudflareinsights.com/beacon.min.js' data-cf-beacon='{"token": "4c1cf1bb4272434b87ed4334d4372a3e"}'></script><!-- Cloudflare Pages Analytics --></body></html>  <script type="module" src="/_astro/HomePage.astro_astro_type_script_index_0_lang.Ba9w8Qoe.