---
import Layout from '../layouts/Layout.astro';
import { getAllPosts, formatDate, estimateReadingTime } from '../lib/posts';
import { renderMarkdown } from '../lib/markdown';
import { siteConfig } from '../lib/config';
import type { Post, PostMeta } from '../lib/posts';

export async function getStaticPaths() {
  const posts = getAllPosts();

  return posts.map((item) => {
    const idx = posts.findIndex((s) => s.slug === item.slug);
    const prev = idx < posts.length - 1 ? posts[idx + 1] : null;
    const next = idx > 0 ? posts[idx - 1] : null;

    return {
      params: { slug: item.slug },
      props: { post: item, prev, next },
    };
  });
}

interface Props {
  post: Post;
  prev: PostMeta | null;
  next: PostMeta | null;
}

const { post, prev, next } = Astro.props;
const { html: contentHtml, headings } = await renderMarkdown(post.content, { slug: post.slug });
const pageTitle = `${post.title} — ${siteConfig.title}`;
const readingTime = estimateReadingTime(post.content);
---

<Layout title={pageTitle} description={post.title} ogType="article" showToc={headings.length > 0}>
  <div class="post-page">
    <article class="post-article" data-copy-label={siteConfig.ui.copyButton} data-copied-label={siteConfig.ui.copiedButton}>
      <header class="post-header">
        <h1 class="post-title">{post.title}</h1>
        <div class="post-meta">
          <time class="post-date" datetime={formatDate(post.date)}>{formatDate(post.date)}</time>
          <span>{siteConfig.ui.readingTime(readingTime)}</span>
        </div>
      </header>

      <div class="prose max-w-none" set:html={contentHtml} />

      <!-- Prev / Next navigation -->
      {(prev || next) && (
        <nav class="post-nav" aria-label="More posts">
          {prev ? (
            <a href={`/${prev.slug}`} class="post-nav-link">
              <span class="post-nav-label">{siteConfig.ui.prevPost}</span>
              <span class="post-nav-title">{prev.title}</span>
            </a>
          ) : <div />}
          {next ? (
            <a href={`/${next.slug}`} class="post-nav-link post-nav-next">
              <span class="post-nav-label">{siteConfig.ui.nextPost}</span>
              <span class="post-nav-title">{next.title}</span>
            </a>
          ) : <div />}
        </nav>
      )}
    </article>

    {headings.length > 0 && (
      <nav class="post-toc" aria-label={siteConfig.ui.tocLabel}>
        <h2 class="toc-label">{siteConfig.ui.tocLabel}</h2>
        <ul>
          {headings.map((h) => (
            <li class={h.level === 3 ? 'toc-h3' : undefined}>
              <a href={`#${h.id}`}>{h.text}</a>
            </li>
          ))}
        </ul>
      </nav>
    )}
  </div>

  <!-- Mobile contents: opened from the header button, covers the panel without motion -->
  {headings.length > 0 && (
    <nav class="toc-sheet" id="toc-sheet" aria-label={siteConfig.ui.tocLabel} hidden>
      <div class="toc-sheet-header">
        <h2 class="toc-sheet-title">{siteConfig.ui.tocLabel}</h2>
        <button class="icon-link icon-link--touch toc-sheet-close" id="toc-sheet-close" aria-label="Close">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18" /></svg>
        </button>
      </div>
      <ul class="toc-sheet-list">
        {headings.map((h) => (
          <li class={h.level === 3 ? 'toc-sheet-h3' : undefined}>
            <a href={`#${h.id}`} class="toc-sheet-link">{h.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  )}
</Layout>

<style>
  .post-page {
    display: flex;
    align-items: flex-start;
    gap: 48px;
    padding: 32px 16px 48px;
  }

  @media (min-width: 640px) {
    .post-page {
      padding: 48px 40px 64px;
    }
  }

  @media (min-width: 1280px) {
    .post-page {
      gap: 64px;
      padding: 64px 64px 80px;
    }
  }

  .post-article {
    flex: 1 1 0;
    min-width: 0;
    max-width: 680px;
  }

  .post-header {
    margin-bottom: 32px;
  }

  @media (min-width: 640px) {
    .post-header {
      margin-bottom: 40px;
    }
  }

  .post-title {
    margin: 0;
    font-size: 24px;
    line-height: 32px;
    font-weight: 600;
    color: var(--text);
  }

  /* Spacing alone separates the meta items */
  .post-meta {
    display: flex;
    gap: 16px;
    margin-top: 12px;
    font-size: 12px;
    line-height: 20px;
    color: var(--text-2);
  }

  .post-date {
    font-family: var(--font-mono);
  }

  /* Desktop TOC */
  .post-toc {
    display: none;
    flex: 0 0 176px;
    position: sticky;
    top: 48px;
  }

  @media (min-width: 1024px) {
    .post-toc {
      display: block;
    }
  }

  @media (min-width: 1280px) {
    .post-toc {
      flex-basis: 208px;
      top: 64px;
    }
  }

  .toc-label {
    margin: 0 0 8px;
    font-size: 12px;
    line-height: 20px;
    font-weight: 600;
    color: var(--text);
  }

  .post-toc ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-toc a {
    display: block;
    padding: 4px 0;
    font-size: 12px;
    line-height: 20px;
    color: var(--text-2);
    text-decoration: none;
    transition: color var(--ease-base);
  }

  .toc-h3 a {
    padding-left: 12px;
  }

  .post-toc a:hover {
    color: var(--text);
  }

  .post-toc a.active {
    color: var(--accent-text);
    font-weight: 500;
  }

  /* Prev / Next navigation */
  .post-nav {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
    margin-top: 48px;
    padding-top: 24px;
    border-top: 0.5px solid var(--line);
  }

  .post-nav-link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    text-decoration: none;
  }

  .post-nav-next {
    text-align: right;
  }

  .post-nav-label {
    font-size: 12px;
    line-height: 20px;
    color: var(--text-2);
  }

  .post-nav-title {
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
    color: var(--text);
    transition: color var(--ease-base);
  }

  .post-nav-link:hover .post-nav-title {
    color: var(--accent-text);
  }

  /* Mobile contents sheet: sits under the 56px header, same shape as the panel */
  .toc-sheet {
    position: fixed;
    top: 56px;
    left: 8px;
    right: 8px;
    bottom: 0;
    z-index: 50;
    display: flex;
    flex-direction: column;
    padding: 16px;
    background-color: var(--bg-panel);
    border: 0.5px solid var(--line-chrome);
    border-bottom: none;
    border-radius: var(--radius-panel) var(--radius-panel) 0 0;
  }

  .toc-sheet[hidden] {
    display: none;
  }

  @media (min-width: 1024px) {
    .toc-sheet {
      display: none;
    }
  }

  .toc-sheet-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 44px;
    margin-bottom: 4px;
    flex-shrink: 0;
  }

  .toc-sheet-title {
    margin: 0;
    font-size: 14px;
    line-height: 20px;
    font-weight: 600;
    color: var(--text);
  }

  .toc-sheet-close {
    margin-right: -14px;
  }

  .toc-sheet-list {
    list-style: none;
    margin: 0;
    padding: 0;
    overflow-y: auto;
    -webkit-overflow-scrolling: touch;
  }

  .toc-sheet-link {
    display: flex;
    align-items: center;
    min-height: 44px;
    font-size: 14px;
    line-height: 20px;
    color: var(--text-2);
    text-decoration: none;
  }

  .toc-sheet-h3 .toc-sheet-link {
    padding-left: 16px;
  }

  .toc-sheet-link.active {
    color: var(--accent-text);
    font-weight: 500;
  }
</style>

<script>
  const tocLinks = document.querySelectorAll<HTMLAnchorElement>('.post-toc a');
  const headingEls = Array.from(
    document.querySelectorAll<HTMLElement>('.prose h2[id], .prose h3[id]')
  );

  // Find the scroll container
  function findScrollContainer(el: Element | null): HTMLElement | Window {
    let node = el?.parentElement;
    while (node) {
      const style = getComputedStyle(node);
      if (style.overflowY === 'auto' || style.overflowY === 'scroll') {
        return node;
      }
      node = node.parentElement;
    }
    return window;
  }

  const article = document.querySelector('.post-article');
  const scrollContainer = findScrollContainer(article);

  function getScrollTop(): number {
    return scrollContainer instanceof HTMLElement
      ? scrollContainer.scrollTop
      : window.scrollY;
  }

  // --- IntersectionObserver for TOC active heading tracking ---
  let currentActiveId = '';

  let setActiveHeading = (id: string) => {
    if (id === currentActiveId) return;
    currentActiveId = id;
    tocLinks.forEach((link) => link.classList.remove('active'));
    if (id) {
      const activeLink = document.querySelector<HTMLAnchorElement>(
        `.post-toc a[href="#${id}"]`
      );
      activeLink?.classList.add('active');
    }
  };

  if (headingEls.length > 0) {
    // Track which headings are currently intersecting
    const visibleHeadings = new Set<string>();

    const observerRoot = scrollContainer instanceof HTMLElement ? scrollContainer : null;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const id = (entry.target as HTMLElement).id;
          if (entry.isIntersecting) {
            visibleHeadings.add(id);
          } else {
            visibleHeadings.delete(id);
          }
        }

        // Pick the first visible heading in document order
        if (visibleHeadings.size > 0) {
          for (const heading of headingEls) {
            if (visibleHeadings.has(heading.id)) {
              setActiveHeading(heading.id);
              return;
            }
          }
        }

        // No heading is intersecting — determine direction from the last entry
        // If we scrolled past all visible headings downward, find the last heading above the viewport
        const scrollTop = getScrollTop();
        const offset = scrollContainer instanceof HTMLElement ? scrollContainer.getBoundingClientRect().top : 0;
        let lastAbove = '';
        for (const heading of headingEls) {
          const rect = heading.getBoundingClientRect();
          if (rect.top - offset <= 0) {
            lastAbove = heading.id;
          }
        }
        if (lastAbove) {
          setActiveHeading(lastAbove);
        }
      },
      {
        root: observerRoot,
        // rootMargin: negative top margin so a heading counts as "active"
        // once it passes ~80px from the top; bottom extends fully
        rootMargin: '-80px 0px 0px 0px',
        threshold: 0,
      }
    );

    headingEls.forEach((el) => observer.observe(el));
  }

  // --- Keep the last heading active once the reader reaches the end ---
  function updateAtBottom() {
    let scrollHeight: number, clientHeight: number;
    if (scrollContainer instanceof HTMLElement) {
      scrollHeight = scrollContainer.scrollHeight;
      clientHeight = scrollContainer.clientHeight;
    } else {
      scrollHeight = document.documentElement.scrollHeight;
      clientHeight = window.innerHeight;
    }
    const scrollTop = getScrollTop();

    // If at bottom, also ensure last heading is active
    const atBottom = scrollTop + clientHeight >= scrollHeight - 2;
    if (atBottom && headingEls.length > 0) {
      setActiveHeading(headingEls[headingEls.length - 1].id);
    }
  }

  (scrollContainer instanceof HTMLElement ? scrollContainer : window)
    .addEventListener('scroll', updateAtBottom, { passive: true });
  updateAtBottom();

  // Heading anchor links (click to copy URL)
  headingEls.forEach((h) => {
    const anchor = document.createElement('a');
    anchor.className = 'heading-anchor';
    anchor.href = `#${h.id}`;
    anchor.textContent = '#';
    anchor.addEventListener('click', async (e) => {
      e.preventDefault();
      const url = `${location.origin}${location.pathname}#${h.id}`;
      await navigator.clipboard.writeText(url);
      anchor.textContent = '✓';
      setTimeout(() => { anchor.textContent = '#'; }, 1500);
    });
    h.prepend(anchor);
  });

  // Code block copy buttons
  const copyLabel = article?.getAttribute('data-copy-label') || 'Copy';
  const copiedLabel = article?.getAttribute('data-copied-label') || 'Copied';

  document.querySelectorAll('.prose .shiki').forEach((block) => {
    const wrapper = document.createElement('div');
    wrapper.className = 'shiki-wrapper';
    block.parentNode!.insertBefore(wrapper, block);
    wrapper.appendChild(block);

    const btn = document.createElement('button');
    btn.className = 'code-copy-btn';
    btn.textContent = copyLabel;
    btn.addEventListener('click', async () => {
      const code = block.querySelector('code')?.textContent || '';
      await navigator.clipboard.writeText(code);
      btn.textContent = copiedLabel;
      setTimeout(() => { btn.textContent = copyLabel; }, 1500);
    });
    wrapper.appendChild(btn);
  });

  // Mobile contents sheet
  const tocOpenBtn = document.getElementById('toc-open-btn');
  const tocSheet = document.getElementById('toc-sheet');
  const tocSheetClose = document.getElementById('toc-sheet-close');
  const tocSheetLinks = document.querySelectorAll<HTMLAnchorElement>('.toc-sheet-link');

  function setTocSheet(open: boolean) {
    if (!tocSheet) return;
    tocSheet.hidden = !open;
    tocOpenBtn?.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  }

  tocOpenBtn?.addEventListener('click', () => setTocSheet(tocSheet?.hidden ?? false));
  tocSheetClose?.addEventListener('click', () => setTocSheet(false));
  tocSheetLinks.forEach((link) => link.addEventListener('click', () => setTocSheet(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setTocSheet(false);
  });

  // Sync active heading to mobile TOC
  function syncMobileTocActive(id: string) {
    tocSheetLinks.forEach((link) => {
      const href = link.getAttribute('href');
      link.classList.toggle('active', href === `#${id}`);
    });
  }

  // Patch setActiveHeading to also update mobile TOC
  const originalSetActiveHeading = setActiveHeading;
  setActiveHeading = function(id: string) {
    originalSetActiveHeading(id);
    syncMobileTocActive(id);
  };
  // Sync initial state
  if (currentActiveId) syncMobileTocActive(currentActiveId);
</script>
