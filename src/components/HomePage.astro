---
import Layout from '../layouts/Layout.astro';
import { getAllPosts, formatDate } from '../lib/posts';
import { siteConfig } from '../lib/config';

// Posts are already sorted newest first, so grouping keeps year order
const yearGroups = getAllPosts().reduce<Array<{ year: string; posts: ReturnType<typeof getAllPosts> }>>((groups, post) => {
  const year = formatDate(post.date).slice(0, 4);
  const last = groups[groups.length - 1];
  if (last && last.year === year) last.posts.push(post);
  else groups.push({ year, posts: [post] });
  return groups;
}, []);
---

<Layout title={siteConfig.title}>
  <div class="px-4 py-5 sm:px-16 sm:py-12">
    <!-- Posts tab -->
    <section id="tab-posts" class="max-w-[720px]">
      {yearGroups.length === 0 && (
        <p class="text-sm" style="color: var(--text-2);">{siteConfig.ui.noPosts}</p>
      )}
      {yearGroups.map((group) => (
        <section class="year-group">
          <h2 class="year-label">{group.year}</h2>
          <ul class="post-list">
            {group.posts.map((post) => (
              <li>
                <a href={`/${post.slug}`} class="post-item">
                  <span class="post-title">{post.title}</span>
                  <time class="post-date" datetime={formatDate(post.date)}>{formatDate(post.date).slice(5)}</time>
                </a>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </section>

    <script is:inline>
      (function() {
        // Tab switching: must run synchronously before paint to prevent flash
        var path = location.pathname.replace(/\/+$/, '');
        var wantMemos = path === '/memo' || location.hash.indexOf('#memos-') === 0;
        if (wantMemos) {
          var tp = document.getElementById('tab-posts');
          var tm = document.getElementById('tab-memos');
          if (tp) tp.classList.add('tab-hidden');
          if (tm) tm.classList.remove('tab-hidden');
        }
      })();
    </script>

    <!-- Memos tab -->
    <section id="tab-memos" class="tab-hidden max-w-[640px]" data-api={siteConfig.memosApiUrl} data-page-size={String(siteConfig.memosPerPage)}>
      <!-- Loading placeholder: static bars, no shimmer -->
      <div id="memo-loading" aria-label={siteConfig.ui.loading}>
        {Array.from({ length: 4 }).map(() => (
          <div class="memo-item">
            <div class="skeleton skeleton-date"></div>
            <div class="skeleton skeleton-body"></div>
          </div>
        ))}
      </div>

      <!-- Error state -->
      <p id="memo-error" class="text-sm tab-hidden" style="color: var(--text-2);">
        {siteConfig.ui.noMemos}
      </p>

      <!-- Memo list (populated by JS) -->
      <div id="memo-list" class="tab-hidden"></div>

      <!-- Load more -->
      <div id="memo-load-more" class="tab-hidden" style="padding: 16px 0;">
        <button
          id="memo-load-more-btn"
          class="load-more-btn"
          data-load-more={siteConfig.ui.loadMore}
          data-loading={siteConfig.ui.loading}
        >
          {siteConfig.ui.loadMore}
        </button>
      </div>
    </section>
  </div>
</Layout>

<style is:global>
  .tab-hidden {
    display: none !important;
  }

  /* Year groups: label above on mobile, left column from sm up */
  .year-group {
    padding: 16px 0;
  }

  .year-group + .year-group {
    border-top: 0.5px solid var(--line);
  }

  @media (min-width: 640px) {
    .year-group {
      display: grid;
      grid-template-columns: 80px minmax(0, 1fr);
    }
  }

  .year-label {
    margin: 0 0 4px;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 20px;
    font-weight: 400;
    color: var(--text-2);
  }

  /* Matches the row's 10px top padding so the year sits on the first title's line */
  @media (min-width: 640px) {
    .year-label {
      margin: 0;
      padding-top: 10px;
    }
  }

  .post-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .post-item {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 24px;
    padding: 10px 0;
    text-decoration: none;
    color: var(--text);
  }

  .post-title {
    font-size: 14px;
    line-height: 20px;
    transition: color var(--ease-base);
  }

  .post-item:hover .post-title {
    color: var(--accent-text);
  }

  .post-date {
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 20px;
    color: var(--text-2);
  }

  /* Memos */
  .memo-item {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 0;
  }

  .memo-item:first-child {
    padding-top: 0;
  }

  .memo-item + .memo-item {
    border-top: 0.5px solid var(--line);
  }

  /* The timestamp doubles as the memo's permalink */
  .memo-time {
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 20px;
    color: var(--text-2);
    text-decoration: none;
    transition: color var(--ease-base);
  }

  .memo-time:hover {
    color: var(--accent-text);
  }

  .memo-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    font-size: 12px;
    line-height: 20px;
    color: var(--text-2);
  }

  .memo-body {
    font-size: 14px;
    line-height: 24px;
    color: var(--text);
    overflow-wrap: break-word;
    word-break: break-word;
    text-autospace: ideograph-alpha ideograph-numeric;
  }

  .memo-body p {
    margin: 0 0 8px;
  }

  .memo-body > :last-child {
    margin-bottom: 0;
  }

  .memo-body ul,
  .memo-body ol {
    margin: 0 0 8px;
    padding-left: 20px;
  }

  .memo-body blockquote {
    margin: 0 0 8px;
    padding: 8px 12px;
    background-color: var(--bg-subtle);
    border-radius: var(--radius-control);
    color: var(--text-2);
  }

  .memo-body pre {
    margin: 0 0 8px;
    padding: 12px 16px;
    border: 0.5px solid var(--line);
    border-radius: var(--radius-block);
    font-family: var(--font-mono);
    font-size: 12px;
    line-height: 20px;
    background-color: var(--bg-subtle);
    overflow-x: auto;
  }

  .memo-body code:not(pre code) {
    font-family: var(--font-mono);
    font-size: 12px;
    padding: 1px 4px;
    border-radius: var(--radius-inline);
    background-color: var(--bg-element);
  }

  .memo-body a {
    color: var(--accent-text);
    text-decoration: none;
    transition: color var(--ease-base);
  }

  .memo-body a:hover {
    color: var(--gold-12);
  }

  .memo-body img {
    max-width: 100%;
    border-radius: var(--radius-control);
    margin: 8px 0;
  }

  .memo-body ul.contains-task-list {
    list-style: none;
    padding-left: 0;
  }

  .memo-body input[type="checkbox"] {
    margin-right: 6px;
  }

  .memo-images {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 8px;
    margin-top: 8px;
  }

  .memo-images img {
    width: 100%;
    height: auto;
    margin: 0;
    object-fit: cover;
    cursor: zoom-in;
  }

  /* Lightbox overlay */
  .lightbox-overlay {
    position: fixed;
    inset: 0;
    z-index: 9999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--black-a11);
    cursor: zoom-out;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--ease-base);
  }

  .lightbox-overlay.active {
    opacity: 1;
    pointer-events: auto;
  }

  .lightbox-overlay img {
    max-width: 90vw;
    max-height: 90vh;
    object-fit: contain;
    border-radius: var(--radius-control);
  }

  .skeleton {
    background-color: var(--bg-element);
    border-radius: var(--radius-inline);
  }

  .skeleton-date {
    width: 128px;
    height: 12px;
    margin: 4px 0;
  }

  .skeleton-body {
    width: 100%;
    max-width: 384px;
    height: 14px;
    margin: 5px 0;
  }

  .load-more-btn {
    height: 36px;
    padding: 0 16px;
    font-family: var(--font-ui);
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
    background: var(--bg-panel);
    border: 0.5px solid var(--line-control);
    border-radius: var(--radius-control);
    cursor: pointer;
    transition: background-color var(--ease-base);
  }

  .load-more-btn:hover:not(:disabled) {
    background: var(--bg-element);
  }

  .load-more-btn:disabled {
    cursor: default;
    color: var(--text-2);
  }
</style>

<script>
  import MarkdownIt from 'markdown-it';
  import githubAlerts from 'markdown-it-github-alerts';
  import { formatMemoDateTime } from '../lib/memo-time.mjs';

  // --- Markdown 渲染器（轻量版，不含语法高亮） ---
  let md: MarkdownIt | null = null;

  function getMd(): MarkdownIt {
    if (md) return md;

    md = new MarkdownIt({ html: true, linkify: true, breaks: true });
    md.enable(['strikethrough']);
    md.use(githubAlerts);

    return md;
  }

  interface MemoAttachment {
    name: string;
    filename: string;
    externalLink: string;
    type: string;
    size: string;
    memo: string;
  }

  interface Memo {
    name: string;
    content: string;
    createTime: string;
    updateTime?: string;
    displayTime?: string | null;
    tags: string[];
    pinned: boolean;
    snippet: string;
    attachments: MemoAttachment[];
  }

  function getMemoId(memo: Memo): string {
    // memo.name is like "memos/123"
    return memo.name.replace('/', '-');
  }

  function renderAttachments(memo: Memo): string {
    const images = (memo.attachments || []).filter((a) => a.type.startsWith('image/'));
    if (images.length === 0) return '';

    const imgs = images.map((a) => {
      const src = a.externalLink || `${apiUrl}/file/${a.name}/${a.filename}`;
      return `<img src="${src}" alt="${a.filename}" loading="lazy" />`;
    });

    return `<div class="memo-images">${imgs.join('')}</div>`;
  }

  function renderMemoItem(renderer: MarkdownIt, memo: Memo): string {
    const html = renderer.render(memo.content);
    const id = getMemoId(memo);
    const tags = memo.tags || [];
    const tagsHtml = tags.length > 0
      ? `<div class="memo-tags">${tags.map((t) => `<span>#${t}</span>`).join('')}</div>`
      : '';

    return `
      <article class="memo-item" id="${id}">
        <a class="memo-time" href="/memo#${id}">${formatMemoDateTime(memo)}</a>
        <div class="memo-body">${html}${renderAttachments(memo)}</div>
        ${tagsHtml}
      </article>`;
  }

  // --- Tab switching ---
  const tabPosts = document.getElementById('tab-posts')!;
  const tabMemos = document.getElementById('tab-memos')!;
  const navLinks = document.querySelectorAll<HTMLAnchorElement>('a[data-tab]');

  function switchTab(tab: 'posts' | 'memos') {
    const isPosts = tab === 'posts';
    tabPosts.classList.toggle('tab-hidden', !isPosts);
    tabMemos.classList.toggle('tab-hidden', isPosts);

    navLinks.forEach((link) => {
      if (link.dataset.tab === tab) link.setAttribute('aria-current', 'page');
      else link.removeAttribute('aria-current');
    });

    if (tab === 'memos' && !memosLoaded) {
      loadMemos();
    }
  }

  navLinks.forEach((link) => {
    link.addEventListener('click', (e) => {
      e.preventDefault();
      const tab = link.dataset.tab as 'posts' | 'memos';
      history.replaceState(null, '', tab === 'memos' ? '/memo' : '/post');
      switchTab(tab);
    });
  });

  function handlePath() {
    const path = window.location.pathname.replace(/\/+$/, '');
    const hasMemoHash = location.hash.startsWith('#memos-');
    switchTab(path === '/memo' || hasMemoHash ? 'memos' : 'posts');
  }

  // --- Memos: 分页加载 ---
  let memosLoaded = false;
  let nextPageToken = '';
  let isLoadingMore = false;
  const apiUrl = tabMemos.dataset.api!;
  const PAGE_SIZE = Number(tabMemos.dataset.pageSize) || 20;

  const loadMoreContainer = document.getElementById('memo-load-more')!;
  const loadMoreBtn = document.getElementById('memo-load-more-btn')! as HTMLButtonElement;

  async function loadMemos() {
    const loading = document.getElementById('memo-loading')!;
    const error = document.getElementById('memo-error')!;
    const list = document.getElementById('memo-list')!;

    try {
      const [renderer, { memos, pageToken }] = await Promise.all([getMd(), fetchMemoPage('')]);

      if (memos.length === 0) {
        loading.classList.add('tab-hidden');
        error.classList.remove('tab-hidden');
        return;
      }

      list.innerHTML = memos.map((m) => renderMemoItem(renderer, m)).join('');
      loading.classList.add('tab-hidden');
      list.classList.remove('tab-hidden');
      memosLoaded = true;
      nextPageToken = pageToken;

      updateLoadMoreUI();

      // Scroll to anchor if hash present
      scrollToHash();
    } catch {
      loading.classList.add('tab-hidden');
      error.classList.remove('tab-hidden');
    }
  }

  async function loadMoreMemos() {
    if (isLoadingMore || !nextPageToken) return;
    isLoadingMore = true;
    loadMoreBtn.disabled = true;
    loadMoreBtn.textContent = loadMoreBtn.dataset.loading!;

    try {
      const renderer = getMd();
      const { memos, pageToken } = await fetchMemoPage(nextPageToken);
      const list = document.getElementById('memo-list')!;

      const fragment = document.createDocumentFragment();
      const temp = document.createElement('div');
      temp.innerHTML = memos.map((m) => renderMemoItem(renderer, m)).join('');
      while (temp.firstChild) fragment.appendChild(temp.firstChild);
      list.appendChild(fragment);

      nextPageToken = pageToken;
      updateLoadMoreUI();
    } catch {
      loadMoreBtn.textContent = loadMoreBtn.dataset.loadMore!;
      loadMoreBtn.disabled = false;
    } finally {
      isLoadingMore = false;
    }
  }

  function updateLoadMoreUI() {
    if (nextPageToken) {
      loadMoreContainer.classList.remove('tab-hidden');
      loadMoreBtn.disabled = false;
      loadMoreBtn.textContent = loadMoreBtn.dataset.loadMore!;
    } else {
      // Nothing left to load: drop the control instead of showing a disabled one
      loadMoreContainer.classList.add('tab-hidden');
    }
  }

  // 点击按钮加载更多
  loadMoreBtn.addEventListener('click', loadMoreMemos);

  async function fetchMemoPage(pageToken: string): Promise<{ memos: Memo[]; pageToken: string }> {
    // Base is needed because the dev API URL is a relative proxy path
    const url = new URL(`${apiUrl}/api/v1/memos`, location.origin);
    url.searchParams.set('pageSize', String(PAGE_SIZE));
    if (pageToken) url.searchParams.set('pageToken', pageToken);

    const res = await fetch(url.toString());
    if (!res.ok) throw new Error(`HTTP ${res.status}`);

    const data = await res.json();
    const memos: Memo[] = data.memos || [];

    // Pinned first, then newest by createTime
    memos.sort((a, b) => {
      if (a.pinned !== b.pinned) return a.pinned ? -1 : 1;
      return b.createTime.localeCompare(a.createTime);
    });

    return { memos, pageToken: data.nextPageToken || '' };
  }

  function scrollToHash() {
    const hash = location.hash.slice(1);
    if (!hash) return;
    const el = document.getElementById(hash);
    if (el) {
      el.scrollIntoView({ block: 'start' });
    }
  }

  handlePath();

  // --- Lightbox for memo images ---
  {
    const overlay = document.createElement('div');
    overlay.className = 'lightbox-overlay';
    document.body.appendChild(overlay);

    function closeLightbox() {
      overlay.classList.remove('active');
      setTimeout(() => { overlay.innerHTML = ''; }, 250);
    }

    overlay.addEventListener('click', closeLightbox);

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') closeLightbox();
    });

    document.getElementById('memo-list')!.addEventListener('click', (e) => {
      const img = (e.target as HTMLElement).closest<HTMLImageElement>('.memo-images img');
      if (!img) return;
      e.stopPropagation();
      const preview = document.createElement('img');
      preview.src = img.src;
      preview.alt = img.alt;
      overlay.innerHTML = '';
      overlay.appendChild(preview);
      requestAnimationFrame(() => overlay.classList.add('active'));
    });
  }
</script>
