---
import ThemeToggle from './ThemeToggle.astro';
import { siteConfig } from '../lib/config';
import { navIcons, externalIcon } from '../lib/nav-icons';
import { mainLinks, iconLinks, tabFor, isActive } from '../lib/nav';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;
---

<aside class="hidden lg:flex lg:flex-col lg:w-56 shrink-0 px-4 py-6 gap-8 min-h-screen scrollable-area">
  <!-- Logo + Title + Theme Toggle -->
  <div class="flex items-center gap-3">
    <a href="/" class="shrink-0">
      <img
        src={siteConfig.avatar}
        alt={siteConfig.title}
        class="w-8 h-8 rounded-full object-cover block"
      />
    </a>
    <span class="text-sm font-semibold flex-1" style="color: var(--text);">
      {siteConfig.title}
    </span>
    <ThemeToggle class="-mr-2" />
  </div>

  <!-- Navigation -->
  <nav class="flex flex-col gap-0.5 flex-1">
    {mainLinks.map((link) => (
      <a
        href={link.href}
        data-tab={tabFor(link.href)}
        target={link.external ? '_blank' : undefined}
        rel={link.external ? 'noopener noreferrer' : undefined}
        aria-current={isActive(link.href, currentPath) ? 'page' : undefined}
        class="nav-item"
      >
        <Fragment set:html={navIcons[link.label] || ''} />
        <span class="flex-1">{link.label}</span>
        {link.external && <Fragment set:html={externalIcon} />}
      </a>
    ))}
  </nav>

  <!-- External icon links -->
  <div class="flex items-center gap-1 -ml-2">
    {iconLinks.map((link) => (
      <a
        href={link.href}
        target="_blank"
        rel="noopener noreferrer"
        class="icon-link"
        aria-label={link.label}
        title={link.label}
      >
        <Fragment set:html={navIcons[link.label] || ''} />
      </a>
    ))}
  </div>
</aside>
