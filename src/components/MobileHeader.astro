---
import { siteConfig } from '../lib/config';
import { navIcons, externalIcon } from '../lib/nav-icons';
import { mainLinks, iconLinks, tabFor, isActive } from '../lib/nav';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  currentPath?: string;
  /** Article pages put the Contents entry here instead of a floating button */
  showToc?: boolean;
}

const { currentPath = '/', showToc = false } = Astro.props;
---

<div class="flex items-center gap-3 h-14 px-4 lg:hidden">
  <!-- Logo -->
  <a href="/" class="flex items-center gap-3 flex-1 min-w-0" style="color: var(--text); text-decoration: none;">
    <img
      src={siteConfig.avatar}
      alt={siteConfig.title}
      class="w-7 h-7 rounded-full object-cover block"
    />
    <span class="font-semibold text-sm">{siteConfig.title}</span>
  </a>

  <!-- -mr-3.5 offsets the 14px inset of the last 44px target so its glyph meets the gutter -->
  <div class="flex items-center -mr-3.5">
    {showToc && (
      <button
        id="toc-open-btn"
        class="icon-link icon-link--touch"
        aria-label={siteConfig.ui.tocLabel}
        aria-expanded="false"
        aria-controls="toc-sheet"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M4 6h16M4 12h10M4 18h13" />
        </svg>
      </button>
    )}
    <ThemeToggle class="icon-link--touch" />
    <button
      id="mobile-menu-btn"
      class="icon-link icon-link--touch"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <svg id="menu-icon-open" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <svg id="menu-icon-close" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" class="hidden" aria-hidden="true">
        <path d="M6 6l12 12M18 6 6 18" />
      </svg>
    </button>
  </div>
</div>

<!-- Mobile nav drawer -->
<div id="mobile-nav" class="hidden lg:hidden px-4 pb-3">
  <nav class="flex flex-col gap-0.5">
    {mainLinks.map((link) => (
      <a
        href={link.href}
        data-tab={tabFor(link.href)}
        target={link.external ? '_blank' : undefined}
        rel={link.external ? 'noopener noreferrer' : undefined}
        aria-current={isActive(link.href, currentPath) ? 'page' : undefined}
        class="nav-item nav-item--touch"
      >
        <Fragment set:html={navIcons[link.label] || ''} />
        <span class="flex-1">{link.label}</span>
        {link.external && <Fragment set:html={externalIcon} />}
      </a>
    ))}
    <div class="flex items-center gap-1 pt-1 -ml-3.5">
      {iconLinks.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="icon-link icon-link--touch"
          aria-label={link.label}
          title={link.label}
        >
          <Fragment set:html={navIcons[link.label] || ''} />
        </a>
      ))}
    </div>
  </nav>
</div>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const nav = document.getElementById('mobile-nav');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');

  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('hidden') === false;
    iconOpen?.classList.toggle('hidden', open);
    iconClose?.classList.toggle('hidden', !open);
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
